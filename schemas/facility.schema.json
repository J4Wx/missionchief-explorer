{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dispatch-atlas/schemas/facility.schema.json",
  "title": "Facility",
  "description": "A single emergency-services facility (the properties of a GeoJSON Feature).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "category", "status", "agency", "address", "units", "game", "sources", "confidence"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Kebab-case slug, unique within the region file."
    },
    "name": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["fire", "ems", "police_local", "sheriff", "state_le", "federal_le", "hospital", "clinic", "prison", "jail", "tow", "dispatch", "coast_guard", "ranger"]
    },
    "subtype": { "type": "string" },
    "subregion_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Optional. References the id of the most specific entry in the region's metadata.subregions (e.g. a borough/district/municipality). Enables local-level narrowing within a region."
    },
    "status": {
      "type": "string",
      "enum": ["active", "closed", "planned", "unknown"],
      "default": "active"
    },
    "agency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["fire_department", "police_department", "sheriff_office", "state_agency", "federal_agency", "ems_agency", "hospital_system", "corrections", "private", "other"]
        },
        "level": {
          "type": "string",
          "enum": ["municipal", "county", "state", "federal", "private", "other"]
        },
        "parent": { "type": ["string", "null"] }
      }
    },
    "designation": { "type": ["string", "null"] },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["city", "state", "country"],
      "properties": {
        "street": { "type": "string" },
        "city": { "type": "string" },
        "county": { "type": "string" },
        "state": { "type": "string" },
        "postal_code": { "type": "string" },
        "country": { "type": "string", "description": "ISO 3166-1 alpha-2, e.g. US." }
      }
    },
    "staffing_model": {
      "type": "string",
      "enum": ["career", "volunteer", "combination", "unknown"]
    },
    "operating_hours": {
      "type": "string",
      "enum": ["24_7", "daytime", "on_call", "unknown"]
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["engine", "ladder", "quint", "rescue", "tanker", "brush", "hazmat", "battalion", "air_light", "arff", "foam", "rehab", "ems_als", "ems_bls", "medic_chase", "mci", "marine", "dive", "air_support", "patrol", "swat", "k9", "mounted", "bomb_squad", "crime_scene", "traffic", "police_air", "police_marine", "tow_light", "tow_medium", "tow_heavy", "flatbed", "other"]
          },
          "designation": { "type": "string" },
          "count": { "type": "integer", "minimum": 1, "default": 1 },
          "attributes": { "type": "object" }
        }
      }
    },
    "specialties": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Controlled capability tags, e.g. hazmat, swat, trauma_level_1."
    },
    "attributes": {
      "type": "object",
      "description": "Category-specific structured extras (hospital beds/trauma_level, jail capacity/security_level, etc.)."
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["building_types"],
      "properties": {
        "building_types": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "recommended": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "significance": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "retrieved": { "type": "string", "format": "date" }
        }
      }
    },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "last_verified": { "type": "string", "format": "date" }
  }
}
