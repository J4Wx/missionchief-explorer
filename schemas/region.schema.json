{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dispatch-atlas/schemas/region.schema.json",
  "title": "Region FeatureCollection",
  "description": "A GeoJSON FeatureCollection of facilities for one region.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "metadata", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "name", "country", "center", "zoom", "schema_version"],
      "properties": {
        "region_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Globally unique region slug, e.g. us-il-springfield."
        },
        "name": { "type": "string" },
        "country": { "type": "string" },
        "center": {
          "type": "array",
          "description": "[lng, lat] default map center.",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "type": "number", "minimum": -180, "maximum": 180 },
            { "type": "number", "minimum": -90, "maximum": 90 }
          ]
        },
        "zoom": { "type": "number", "minimum": 0, "maximum": 22 },
        "subregions": {
          "type": "array",
          "description": "Optional local-level divisions within the region (e.g. NYC boroughs, county municipalities, city districts). Facilities reference these via properties.subregion_id. May be nested via 'parent' to form a hierarchy.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "Unique-within-region subregion slug, e.g. manhattan."
              },
              "name": { "type": "string", "minLength": 1 },
              "level": {
                "type": "string",
                "enum": ["borough", "county", "municipality", "district", "township", "precinct", "sector", "neighborhood", "other"],
                "description": "Kind of local division, for labeling/grouping in the UI."
              },
              "parent": {
                "type": ["string", "null"],
                "description": "Optional id of a parent subregion (for nesting, e.g. neighborhood within borough). Must reference another subregion id."
              },
              "center": {
                "type": "array",
                "description": "Optional [lng, lat] to recenter the map when this subregion is selected.",
                "minItems": 2,
                "maxItems": 2,
                "prefixItems": [
                  { "type": "number", "minimum": -180, "maximum": 180 },
                  { "type": "number", "minimum": -90, "maximum": 90 }
                ]
              },
              "zoom": { "type": "number", "minimum": 0, "maximum": 22 },
              "bbox": {
                "type": "array",
                "description": "Optional [west, south, east, north] bounds.",
                "minItems": 4,
                "maxItems": 4,
                "items": { "type": "number" }
              }
            }
          }
        },
        "generated_by": { "type": "string", "enum": ["agent", "human"] },
        "generated_at": { "type": "string", "format": "date" },
        "schema_version": { "type": "integer", "minimum": 1 }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "geometry", "properties"],
        "properties": {
          "type": { "const": "Feature" },
          "geometry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "coordinates"],
            "properties": {
              "type": { "const": "Point" },
              "coordinates": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "prefixItems": [
                  { "type": "number", "minimum": -180, "maximum": 180 },
                  { "type": "number", "minimum": -90, "maximum": 90 }
                ]
              }
            }
          },
          "properties": { "$ref": "facility.schema.json" }
        }
      }
    }
  }
}
