{
  "name": "dispatch-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Map-first explorer of emergency-services facilities for Mission Chief planning.",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run gen:types && tsc --noEmit && vite build",
