  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@maplibre/maplibre-gl-style-spec": "^26.2.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.11.0",
    "json-schema-to-typescript": "^15.0.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.2",
